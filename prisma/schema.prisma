generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CardStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProfileSettings {
  id                 String  @id @default("singleton")
  brandName          String  @default("MaceSlotsBonus")
  logoUrl            String?
  avatarUrl          String?
  description        String  @default("Kuratierte Angebote an einem Ort.")
  noticeText         String?
  shareEnabled        Boolean @default(true)
  publicClicksVisible Boolean @default(false)
  searchEnabled       Boolean @default(true)

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  robotsIndex    Boolean @default(true)

  // Legal text (operator-provided, no legal advice generated)
  impressumText  String?
  datenschutzText String?
  affiliateText  String?
  kontaktText    String?
  disclaimerText String?

  // Footer link visibility (page routes stay available even when hidden here)
  showImpressumLink   Boolean @default(true)
  showDatenschutzLink Boolean @default(true)
  showAffiliateLink   Boolean @default(true)
  showKontaktLink     Boolean @default(true)
  showDisclaimerLink  Boolean @default(true)

  // Design tokens (JSON-encoded DesignConfig)
  designConfig   String  @default("{}")
  activeThemeId  String?

  updatedAt DateTime @updatedAt
}

model ThemePreset {
  id           String  @id @default(cuid())
  name         String  @unique
  isBuiltIn    Boolean @default(false)
  config       String // JSON-encoded DesignConfig
  createdAt    DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
}

model Card {
  id          String     @id @default(cuid())
  title       String
  shortDesc   String
  longDesc    String?
  imageUrl    String?
  imageAlt    String?
  badge       String?
  promoCode   String?
  oldPrice    String?
  newPrice    String?
  discountText String?
  expiresAt   DateTime?
  hint        String?

  ctaText     String  @default("Jetzt ansehen")
  ctaUrl      String
  ctaNewTab   Boolean @default(true)
  cta2Text    String?
  cta2Url     String?
  cta2NewTab  Boolean @default(true)

  tags        String  @default("[]") // JSON array of strings

  status      CardStatus @default(DRAFT)
  featured    Boolean    @default(false)
  position    Int        @default(0)

  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  clicks      ClickEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([position])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  position  Int      @default(0)
  active    Boolean  @default(true)
}

model ClickEvent {
  id         String     @id @default(cuid())
  cardId     String
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  referrer   String?
  deviceType DeviceType @default(UNKNOWN)
  ipHash     String?

  @@index([cardId])
  @@index([createdAt])
}
