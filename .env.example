# Datenbankverbindung (lokal: SQLite-Datei, produktiv: PostgreSQL-URL moeglich)
DATABASE_URL="file:./dev.db"

# Geheimer Schluessel zum Signieren der Admin-Session (mind. 32 zufaellige Zeichen)
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-value"

# Basis-URL der Anwendung (fuer absolute Links, SEO, OG-Tags)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Auf "production" setzen fuer echte Deployments (aktiviert sichere Cookies etc.)
NODE_ENV="development"
