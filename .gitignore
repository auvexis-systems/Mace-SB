# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database (any local SQLite file/journal, not just dev.db)
/prisma/*.db
/prisma/*.db-journal
*.sqlite
*.sqlite3

# local pre-change database backups (see prisma/import-media-pack.ts)
/prisma/backups/

# generated prisma client
/src/generated

# user uploads
/public/uploads/*
!/public/uploads/.gitkeep

# generated admin credentials
ADMIN_CREDENTIALS.txt

# raw source for one-time asset imports (see prisma/import-media-pack.ts) —
# only the copied, deployed output in /public/media-pack is tracked
/assets/

# typescript
*.tsbuildinfo
next-env.d.ts
